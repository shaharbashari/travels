rules_version = '2';
// חוקי אבטחה ל-Firestore של "הטיולים של הדר".
// קריאה: פתוחה לכולם. כתיבה: רק לשני העורכים המורשים (עם אימות מייל).
// פרסום: Firebase Console → Firestore Database → Rules → הדביקו → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function isEditor() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
             'hadarlap@gmail.com',
             'shahar.bashari@gmail.com'
           ];
    }

    match /tours/{tourId} {
      allow read: if true;
      allow create, update, delete: if isEditor();
    }

    // מקום לנתוני-עזר עתידיים (הגדרות, מטא-דאטה) — אותה מדיניות.
    match /meta/{doc} {
      allow read: if true;
      allow write: if isEditor();
    }
  }
}
